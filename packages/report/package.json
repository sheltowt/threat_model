{
  "name": "@tmc/report",
  "version": "0.1.0",
  "type": "module",
  "description": "Markdown, HTML, SARIF and JSON reporting",
  "license": "Apache-2.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "data",
    "rules",
    "templates"
  ],
  "scripts": {
    "build": "tsc --build"
  },
  "dependencies": {
    "@tmc/core": "0.1.0",
    "@tmc/rules": "0.1.0",
    "@tmc/render": "0.1.0"
  }
}
