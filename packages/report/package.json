{
  "name": "tmac-report",
  "version": "0.1.0",
  "type": "module",
  "description": "Markdown, HTML, SARIF and JSON reporting",
  "license": "Apache-2.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "data",
    "rules",
    "templates"
  ],
  "scripts": {
    "build": "tsc --build"
  },
  "dependencies": {
    "tmac-core": "^0.1.0",
    "tmac-rules": "^0.1.0",
    "tmac-render": "^0.1.0"
  },
  "author": "B. Shelton",
  "homepage": "https://github.com/sheltowt/threat_model#readme",
  "bugs": {
    "url": "https://github.com/sheltowt/threat_model/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sheltowt/threat_model.git",
    "directory": "packages/report"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "tmac",
    "threat-modeling",
    "threat-model-as-code",
    "threat-model",
    "sarif",
    "report"
  ]
}
