{
  "name": "@tmc/render",
  "version": "0.1.0",
  "type": "module",
  "description": "Data flow and data asset diagram rendering",
  "license": "Apache-2.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    },
    "./package.json": "./package.json",
    "./svg-text": {
      "types": "./dist/svg-text.d.ts",
      "default": "./dist/svg-text.js"
    }
  },
  "files": [
    "dist",
    "data",
    "rules",
    "templates"
  ],
  "scripts": {
    "build": "tsc --build"
  },
  "dependencies": {
    "@tmc/core": "0.1.0",
    "@viz-js/viz": "^3.30.0"
  }
}
