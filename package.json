{
  "name": "tmac-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "tmac - threat models as code",
  "license": "Apache-2.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run generate && tsc --build && npm run build --workspace tmac-web",
    "clean": "tsc --build --clean",
    "typecheck": "tsc --build && npm run typecheck --workspace tmac-web",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "tmac": "node --experimental-strip-types apps/cli/src/index.ts",
    "generate": "node scripts/generate-data.mjs",
    "generate:check": "node scripts/generate-data.mjs --check",
    "build:lib": "npm run generate && tsc --build",
    "dev": "npm run dev --workspace tmac-web",
    "bundle:editor": "node scripts/bundle-editor.mjs",
    "schema": "node scripts/emit-schema.mjs",
    "schema:check": "node scripts/emit-schema.mjs --check"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^3.2.7",
    "happy-dom": "^20.14.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
