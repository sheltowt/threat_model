{
  "name": "tmc-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "tmc - threat models as code",
  "license": "Apache-2.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc --build",
    "clean": "tsc --build --clean",
    "typecheck": "tsc --build --dry 2>/dev/null || tsc --build",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "tmc": "node --experimental-strip-types apps/cli/src/index.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^3.2.7",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
